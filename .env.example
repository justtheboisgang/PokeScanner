# ---------------------------------------------------------------------------
# PokeScanner configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# All secrets live here, never in code (Architektur-Grundregel: R5).
# ---------------------------------------------------------------------------

# --- Database ---
# Async-capable URL is derived automatically; this is the sync SQLAlchemy URL.
DATABASE_URL=postgresql+psycopg://poke:poke@db:5432/pokescanner

# --- SoldComps (echte Verkäufe + Ask-Seite) ---
# Bearer token, format sc_...
SOLDCOMPS_API_KEY=
SOLDCOMPS_BASE_URL=https://api.sold-comps.com
# Default market for sold comps. "wo gehandelt wurde", nicht Kartensprache.
SOLDCOMPS_EBAY_SITE=ebay.de
# Batch jobs stop cleanly at the monthly limit instead of burning credits (R2/§4.2.3).
SOLDCOMPS_CREDIT_SOURCE=subscription-only
# Optional: lift page size to 200 via a SEPARATE eBay account's cookies.
# Default OFF (§4.2.4). Only enable with a dedicated monitoring account.
SOLDCOMPS_USE_COOKIES=false
SOLDCOMPS_EBAY_COOKIES=
# Minimum seconds between requests when cookies are used (§4.2.4: 2-3s).
SOLDCOMPS_COOKIE_MIN_INTERVAL=3.0
# Client-side throttle to stay under the 60/min standard-plan rate limit (§4.2.5).
SOLDCOMPS_MAX_REQUESTS_PER_MINUTE=55

# --- TCGdex (Metadaten + Cardmarket-Referenz) ---
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# Primary language for metadata/pricing; falls back to `en` per card (§4.1).
TCGDEX_PRIMARY_LANG=de

# --- Reference value cascade (§6) ---
# N: Mindeststichprobe für Stufe 1/2 (Median nur ab N Sold-Comps im Fenster).
CASCADE_MIN_SAMPLE_SIZE=5
# Zeitfenster für Sold-Comps in Tagen.
CASCADE_WINDOW_DAYS=90
# Zustandsfaktor: gemischt-Zustand-Median × Faktor (Stufe 2).
CASCADE_CONDITION_FACTOR=0.6
# Sprachfaktor DE->EN: EN-Median × Faktor (Stufe 3).
CASCADE_LANGUAGE_FACTOR=0.8

# --- Alert / buy thresholds (§7) ---
# Alarmschwelle: geschätzter Gewinn in EUR (bewusst niedrig für Flow/Kalibrierung).
ALERT_MIN_PROFIT_EUR=20
# Kaufschwelle Versand / Abholung (nur Referenz für die Website, nicht Alarm).
BUY_THRESHOLD_SHIPPING_EUR=30
BUY_THRESHOLD_PICKUP_EUR=80
# Einzelkarten-Nachschlagschwelle: darunter wird keine Einzelkarte bewertet.
SINGLE_CARD_LOOKUP_THRESHOLD_EUR=15

# --- Apify (Kleinanzeigen, §4.4) ---
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
# Actor id (Tilde-Form für die API). Default: beatanalytics~kleinanzeigen-scraper
APIFY_KLEINANZEIGEN_ACTOR=beatanalytics~kleinanzeigen-scraper
# Optional: exaktes Actor-Eingabeformat als JSON, "{{query}}" = Suchbegriff.
# Leer = Standard (search/query/keyword). Nur setzen, falls der erste Lauf nichts
# liefert und der Actor ein anderes Feld erwartet, z.B.:
# APIFY_KLEINANZEIGEN_INPUT={"keywords":"{{query}}","maxItems":40}
APIFY_KLEINANZEIGEN_INPUT=
# Cap items per query to bound cost (Plan-Guthaben + Actor-Gebühren, §4.4).
APIFY_MAX_ITEMS_PER_QUERY=40

# --- Channels (Phase 5) ---
KLEINANZEIGEN_ENABLED=true
# willhaben via Apify (eigener Actor).
WILLHABEN_ENABLED=false
APIFY_WILLHABEN_ACTOR=
# eBay Browse API (offiziell, ~5000 Calls/Tag). Braucht App-Credentials.
EBAY_BROWSE_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE
EBAY_OAUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_BROWSE_BASE_URL=https://api.ebay.com
EBAY_BROWSE_LIMIT=50

# --- Cross-Channel-Dedup (§5): Bildhash + Preis ---
DEDUP_IMAGE_HASH_ENABLED=true
DEDUP_PRICE_TOLERANCE_EUR=5
# aHash Hamming-Toleranz für re-enkodierte Bilder. 0 = exakter Match (schnell).
DEDUP_HAMMING_THRESHOLD=0
DEDUP_HAMMING_LOOKBACK=500

# --- Kosten-Schätzung pro Call (§9), EUR. Default 0 = nur Verbrauch anzeigen. ---
COST_APIFY_PER_RUN_EUR=0
COST_EBAY_PER_CALL_EUR=0
COST_VISION_PER_CALL_EUR=0

# --- Alarm gate (Phase 2, §7) ---
# Absolute Preisobergrenze in EUR. Leer = keine Grenze (R4, Default).
ALERT_PRICE_CEILING_EUR=
# true = Listings ohne Preis feuern NICHT. Default false ("VB"/leer feuert).
ALERT_REQUIRE_PRICE=false

# --- Poll schedule (gestaffelt, §11) ---
SCHEDULER_TIMEZONE=Europe/Berlin
POLL_DAY_INTERVAL_MINUTES=15
POLL_NIGHT_INTERVAL_MINUTES=60
POLL_DAY_START_HOUR=8
POLL_DAY_END_HOUR=23

# --- Enrichment / Vision (Phase 4, §10/§11) ---
# Vision-Triage läuft NACH dem Alarm, parallel, nie im kritischen Pfad. Nur
# Hinweise — nie Kauf-/Zustands-/Echtheitsurteil, nie Preis.
ANTHROPIC_API_KEY=
ENRICH_VISION_ENABLED=true
ENRICH_VISION_MODEL=claude-opus-5
# Hartes Cap an Vision-Calls pro Poll (Kostendeckel).
ENRICH_VISION_MAX_PER_POLL=20
# Max. Bilder pro Kandidat an das Vision-Modell.
ENRICH_VISION_MAX_IMAGES=4

# --- Web API ---
# CORS: kommagetrennte erlaubte Origins. "*" nur für Dev; in Produktion die
# echte Frontend-Origin setzen, z.B. https://poke.example.com
CORS_ALLOW_ORIGINS=*

# --- Discord (§8) ---
DISCORD_WEBHOOK_URL=
